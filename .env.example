# Salin file ini menjadi .env lalu isi GEMINI_API_KEY dengan API key asli Anda.
# Dapatkan API key di: https://aistudio.google.com/apikey

GEMINI_API_KEY=masukkan_api_key_gemini_anda_di_sini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Cadangan Otomatis Groq Cloud Gratis (Opsi A: Gemini utama -> Groq cadangan)
# Dapatkan API key gratis di: https://console.groq.com/keys
AI_PRIMARY_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Pengaturan Agent 1: Riset Tren
TRENDS_GEO=ID
TRENDS_MAX_ITEMS=20
TRENDS_MAX_IDEAS=3

# Disiapkan untuk integrasi Telegram Bot di tahap selanjutnya (boleh dikosongkan dulu)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keamanan & Cloud Deploy (Hugging Face Spaces / Render — kosongkan di PC lokal)
OFFICE_PASSWORD=
CUSTOM_AGENT_NAMES=
